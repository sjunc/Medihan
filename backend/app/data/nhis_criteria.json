      "unit": "mmHg",
      "reference": "120 미만 / 80 미만",
      "bands": [
        {"status": "질환의심(고혈압)", "severity": "high", "recommend": ["내과", "순환기내과", "가정의학과"], "confirm_exam": "고혈압",
         "any": [{"input": "systolic_bp", "gte": 140}, {"input": "diastolic_bp", "gte": 90}]},
        {"status": "정상B(경계)", "severity": "warning", "recommend": ["가정의학과", "내과"],
         "any": [{"input": "systolic_bp", "gte": 120}, {"input": "diastolic_bp", "gte": 80}]},
        {"status": "정상A", "severity": "normal"}
      ]
    },
    "fasting_glucose": {
