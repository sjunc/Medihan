      "by_gender": {
        "male": {"reference": "13.0~16.5(남)"},
        "female": {
          "reference": "12.0~15.5(여)",
          "bands": [
            {"status": "질환의심(빈혈)", "severity": "high", "recommend": ["내과", "혈액내과"],
