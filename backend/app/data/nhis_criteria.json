         "any": [{"input": "bmi", "gte": 30.0}]},
        {"status": "과체중/비만전단계", "severity": "warning", "recommend": ["가정의학과"],
         "any": [{"input": "bmi", "gte": 25.0}]},
        {"status": "저체중", "severity": "warning", "recommend": ["가정의학과"],
